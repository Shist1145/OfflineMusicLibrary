<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="OfflineMusicLibrary.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OfflineMusicLibrary" Title="设置与个性化" Width="1020" Height="760" MinWidth="900" MinHeight="650" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,4,0,14" />
      </Style>
      <Style x:Key="SettingLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      </Style>
      <Style x:Key="HintStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="68" />
    </Grid.RowDefinitions>
    <TabControl Margin="18,14,18,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
      <TabItem Header="常规">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,22">
            <TextBlock Text="外观与字体" Style="{StaticResource SectionTitleStyle}" />
            <Grid Margin="0,0,0,24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="界面字体" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="UiFontCombo" Grid.Column="1" Width="330" HorizontalAlignment="Left" IsEditable="True" IsTextSearchEnabled="True" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="列出 Windows 已安装字体；保存后主界面立即应用。" Style="{StaticResource HintStyle}" />
            </Grid>
            <Separator />
            <TextBlock Text="启动与关闭" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,14" />
            <CheckBox Name="RunAtStartupCheckBox" Content="开机自动运行" Margin="0,0,0,12" />
            <CheckBox Name="StartMinimizedCheckBox" Content="启动后最小化展示" Margin="0,0,0,12" />
            <CheckBox Name="FloatingMiniPlayerCheckBox" Content="主窗口最小化时显示悬浮迷你播放器" ToolTip="关闭后仍可把鼠标悬浮在任务栏图标上使用按需迷你播放器" Margin="0,0,0,18" />
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="关闭主窗口" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="CloseBehaviorCombo" Grid.Column="1" Width="260" HorizontalAlignment="Left">
                <ComboBoxItem Content="退出程序" Tag="Exit" />
                <ComboBoxItem Content="最小化到系统托盘" Tag="MinimizeToTray" />
                <ComboBoxItem Content="最小化到任务栏" Tag="Minimize" />
              </ComboBox>
            </Grid>
            <Separator />
            <TextBlock Text="定时关闭" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,14" />
            <CheckBox Name="AutoCloseCheckBox" Content="开启定时关闭播放器" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=AutoCloseCheckBox}">
              <TextBlock Text="剩余关闭时间" VerticalAlignment="Center" Margin="0,0,14,0" />
              <ComboBox Name="AutoCloseHoursCombo" Width="110" />
              <TextBlock Text="小时" VerticalAlignment="Center" Margin="8,0,18,0" />
              <ComboBox Name="AutoCloseMinutesCombo" Width="110" />
              <TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="个性化">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,22">
            <TextBlock Text="主题与外观" Style="{StaticResource SectionTitleStyle}" />
            <Grid Margin="0,0,0,24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="56" />
                <RowDefinition Height="56" />
                <RowDefinition Height="56" />
              </Grid.RowDefinitions>
              <TextBlock Text="主题" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="UiThemeCombo" Grid.Column="1" Width="330" HorizontalAlignment="Left" SelectionChanged="UiThemeCombo_SelectionChanged">
                <ComboBoxItem Content="沉静蓝" Tag="Blue" />
                <ComboBoxItem Content="薄荷青" Tag="Mint" />
                <ComboBoxItem Content="小草绿" Tag="Green" />
                <ComboBoxItem Content="菠萝黄" Tag="Yellow" />
                <ComboBoxItem Content="橡木棕" Tag="Brown" />
                <ComboBoxItem Content="秋仪金" Tag="Gold" />
                <ComboBoxItem Content="铁杆粉" Tag="Pink" />
                <ComboBoxItem Content="酷炫黑" Tag="Dark" />
                <ComboBoxItem Content="自定义强调色" Tag="Custom" />
              </ComboBox>
              <TextBlock Grid.Row="1" Text="自定义强调色" Style="{StaticResource SettingLabelStyle}" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <Button Name="CustomAccentButton" Content="选择颜色" Width="170" HorizontalAlignment="Left" Click="CustomAccentButton_Click" />
                <TextBlock Text="选择后自动切换到自定义主题" Style="{StaticResource HintStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="界面背景透明度" Style="{StaticResource SettingLabelStyle}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <Slider Name="UiSurfaceOpacitySlider" Width="330" Minimum="0.72" Maximum="1" TickFrequency="0.02" IsSnapToTickEnabled="True" ValueChanged="UiSurfaceOpacitySlider_ValueChanged" />
                <TextBlock Name="UiSurfaceOpacityText" Width="62" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Row="3" Text="窗口标题" Style="{StaticResource SettingLabelStyle}" />
              <TextBox Name="AppTitleTextBox" Grid.Row="3" Grid.Column="1" Width="330" HorizontalAlignment="Left" MaxLength="32" ToolTip="留空时使用“本地音乐库”" />
            </Grid>

            <Separator />
            <TextBlock Text="背景图片" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,14" />
            <Grid Margin="0,0,0,24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="当前背景" Style="{StaticResource SettingLabelStyle}" />
              <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Name="BackgroundImagePathTextBox" IsReadOnly="True" />
                <Button Grid.Column="1" Content="选择图片" Margin="8,0,0,0" Click="ChooseBackgroundImageButton_Click" />
                <Button Grid.Column="2" Content="清除" Margin="8,0,0,0" Click="ClearBackgroundImageButton_Click" />
              </Grid>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="支持 JPG、PNG、BMP 与 WebP；透明度仅在设置背景图片后生效。" Style="{StaticResource HintStyle}" />
            </Grid>

            <Separator />
            <TextBlock Text="主页与侧栏" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,14" />
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="启动主页" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="StartPageCombo" Grid.Column="1" Width="330" HorizontalAlignment="Left">
                <ComboBoxItem Content="为你推荐" Tag="Discover" />
                <ComboBoxItem Content="全部音乐" Tag="All" />
                <ComboBoxItem Content="我的收藏" Tag="Favorites" />
                <ComboBoxItem Content="专辑" Tag="Albums" />
                <ComboBoxItem Content="最近添加" Tag="Recent" />
              </ComboBox>
            </Grid>
            <TextBlock Text="侧栏显示" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" />
            <WrapPanel>
              <CheckBox Name="ShowRecommendationsCheckBox" Content="为你推荐" Margin="0,0,28,12" />
              <CheckBox Name="ShowCirclesCheckBox" Content="社团" Margin="0,0,28,12" />
              <CheckBox Name="ShowRecentCheckBox" Content="最近添加" Margin="0,0,28,12" />
              <CheckBox Name="ShowHistoryCheckBox" Content="播放历史" Margin="0,0,28,12" />
              <CheckBox Name="ShowCategoriesCheckBox" Content="分类" Margin="0,0,28,12" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="播放">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,22">
            <TextBlock Text="音量" Style="{StaticResource SectionTitleStyle}" />
            <Grid Margin="0,0,0,24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="默认音量" Style="{StaticResource SettingLabelStyle}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Slider Name="DefaultVolumeSlider" Width="330" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="DefaultVolumeSlider_ValueChanged" />
                <TextBlock Name="DefaultVolumeText" Width="60" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <Separator />
            <TextBlock Text="启动播放" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,14" />
            <CheckBox Name="AutoPlayOnStartupCheckBox" Content="程序启动时自动播放上次歌曲" Margin="0,0,0,12" />
            <CheckBox Name="RememberPlaybackProgressCheckBox" Content="记住上次歌曲和播放进度" Margin="0,0,0,24" />
            <Separator />
            <TextBlock Text="播放列表行为" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,14" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="双击歌曲时" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="DoubleClickQueueModeCombo" Grid.Column="1" Width="420" HorizontalAlignment="Left">
                <ComboBoxItem Content="用当前歌曲所在列表替换播放队列" Tag="Replace" />
                <ComboBoxItem Content="只把当前歌曲加入播放队列并播放" Tag="Append" />
              </ComboBox>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="快捷键">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,22">
            <TextBlock Text="快捷键" Style="{StaticResource SectionTitleStyle}" />
            <CheckBox Name="GlobalHotkeysCheckBox" Content="启用全局快捷键（播放器在后台时也能响应）" Margin="0,0,0,12" />
            <CheckBox Name="SystemMediaKeysCheckBox" Content="使用系统媒体键（播放/暂停、上一首、下一首）" Margin="0,0,0,20" />
            <Border Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="210" />
                  <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="38" />
                  <RowDefinition Height="38" />
                  <RowDefinition Height="38" />
                  <RowDefinition Height="38" />
                  <RowDefinition Height="38" />
                  <RowDefinition Height="38" />
                  <RowDefinition Height="38" />
                </Grid.RowDefinitions>
                <TextBlock Text="功能" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="窗口内快捷键" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="全局快捷键" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="播放 / 暂停" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl + P / Space" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Ctrl + Alt + P" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="上一首" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Ctrl + Left" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Ctrl + Alt + Left" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Text="下一首" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Ctrl + Right" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Ctrl + Alt + Right" VerticalAlignment="Center" />
                <TextBlock Grid.Row="4" Text="音量加 / 减" VerticalAlignment="Center" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Ctrl + Up / Down" VerticalAlignment="Center" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Ctrl + Alt + Up / Down" VerticalAlignment="Center" />
                <TextBlock Grid.Row="5" Text="打开 / 关闭桌面歌词" VerticalAlignment="Center" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="Ctrl + D" VerticalAlignment="Center" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="Ctrl + Alt + D" VerticalAlignment="Center" />
                <TextBlock Grid.Row="6" Text="收藏歌曲 / 最小化" VerticalAlignment="Center" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="Ctrl + L / Ctrl + M" VerticalAlignment="Center" />
                <TextBlock Grid.Row="6" Grid.Column="2" Text="Ctrl + Alt + L / M" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="音视频">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="28,22">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="210" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="60" />
              <RowDefinition Height="60" />
              <RowDefinition Height="60" />
              <RowDefinition Height="60" />
              <RowDefinition Height="60" />
              <RowDefinition Height="60" />
              <RowDefinition Height="60" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="音频输出后端" Style="{StaticResource SettingLabelStyle}" />
            <ComboBox Name="AudioBackendCombo" Grid.Column="1" Width="300" HorizontalAlignment="Left">
              <ComboBoxItem Content="DirectSound（稳定优先，推荐）" Tag="DirectSound" />
              <ComboBoxItem Content="自动选择" Tag="Auto" />
              <ComboBoxItem Content="WASAPI" Tag="Wasapi" />
              <ComboBoxItem Content="WaveOut（兼容模式）" Tag="WaveOut" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="硬件加速解码" Style="{StaticResource SettingLabelStyle}" />
            <ComboBox Name="HardwareDecodingCombo" Grid.Row="1" Grid.Column="1" Width="300" HorizontalAlignment="Left">
              <ComboBoxItem Content="自动（推荐）" Tag="Auto" />
              <ComboBoxItem Content="Direct3D 11 VA" Tag="D3D11VA" />
              <ComboBoxItem Content="DXVA 2" Tag="DXVA2" />
              <ComboBoxItem Content="关闭硬件解码" Tag="Disabled" />
            </ComboBox>
            <TextBlock Grid.Row="2" Text="视频输出方式" Style="{StaticResource SettingLabelStyle}" />
            <ComboBox Name="VideoOutputCombo" Grid.Row="2" Grid.Column="1" Width="300" HorizontalAlignment="Left">
              <ComboBoxItem Content="自动（推荐）" Tag="Auto" />
              <ComboBoxItem Content="Direct3D 11" Tag="Direct3D11" />
              <ComboBoxItem Content="Direct3D 9" Tag="Direct3D9" />
              <ComboBoxItem Content="OpenGL" Tag="OpenGL" />
            </ComboBox>
            <TextBlock Grid.Row="3" Text="默认音频可视化" Style="{StaticResource SettingLabelStyle}" />
            <ComboBox Name="VisualizationModeCombo" Grid.Row="3" Grid.Column="1" Width="300" HorizontalAlignment="Left">
              <ComboBoxItem Content="关闭" Tag="Off" />
              <ComboBoxItem Content="频谱" Tag="Spectrum" />
              <ComboBoxItem Content="频谱仪" Tag="Spectrometer" />
              <ComboBoxItem Content="波形" Tag="Scope" />
            </ComboBox>
            <TextBlock Grid.Row="4" Text="均衡器预设" Style="{StaticResource SettingLabelStyle}" />
            <ComboBox Name="EqualizerPresetCombo" Grid.Row="4" Grid.Column="1" Width="300" HorizontalAlignment="Left">
              <ComboBoxItem Content="关闭（原声）" Tag="Off" />
              <ComboBoxItem Content="低音增强" Tag="BassBoost" />
              <ComboBoxItem Content="人声清晰" Tag="Vocal" />
              <ComboBoxItem Content="流行" Tag="Pop" />
              <ComboBoxItem Content="摇滚" Tag="Rock" />
              <ComboBoxItem Content="电子" Tag="Electronic" />
              <ComboBoxItem Content="古典" Tag="Classical" />
              <ComboBoxItem Content="深夜柔和" Tag="Night" />
            </ComboBox>
            <TextBlock Grid.Row="5" Text="空间音效" Style="{StaticResource SettingLabelStyle}" />
            <ComboBox Name="SpatialAudioCombo" Grid.Row="5" Grid.Column="1" Width="300" HorizontalAlignment="Left">
              <ComboBoxItem Content="关闭（推荐）" Tag="Off" />
              <ComboBoxItem Content="立体声拓宽" Tag="StereoWide" />
              <ComboBoxItem Content="3D 房间环绕" Tag="Room3D" />
            </ComboBox>
            <TextBlock Grid.Row="6" Text="播放器画面字幕" Style="{StaticResource SettingLabelStyle}" />
            <CheckBox Name="InPlayerSubtitlesCheckBox" Grid.Row="6" Grid.Column="1" Content="显示原文和中文翻译" VerticalAlignment="Center" />
            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="均衡器可即时切换；空间音效会从当前位置重建播放器。3D 房间环绕是双声道空间化效果，并非 Dolby 多声道。出现第三方驱动冲突时请关闭空间音效并使用 DirectSound。" Style="{StaticResource HintStyle}" Margin="0,14,0,0" />
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="稳定性">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,22">
            <TextBlock Text="播放自动恢复" Style="{StaticResource SectionTitleStyle}" />
            <CheckBox Name="PlaybackRecoveryCheckBox" Content="检测播放错误或卡死后自动重建播放引擎" Margin="0,0,0,16" />
            <Grid Margin="0,0,0,14" IsEnabled="{Binding IsChecked, ElementName=PlaybackRecoveryCheckBox}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="58" />
              </Grid.RowDefinitions>
              <TextBlock Text="卡死判定时间" Style="{StaticResource SettingLabelStyle}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Slider Name="PlaybackWatchdogTimeoutSlider" Width="300" Minimum="8" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PlaybackWatchdogTimeoutSlider_ValueChanged" />
                <TextBlock Name="PlaybackWatchdogTimeoutText" Width="70" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="单曲恢复次数" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="PlaybackRecoveryAttemptsCombo" Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left" />
            </Grid>
            <CheckBox Name="SkipFailedTrackCheckBox" Content="连续恢复失败后自动跳到下一首" Margin="0,0,0,12" IsEnabled="{Binding IsChecked, ElementName=PlaybackRecoveryCheckBox}" />
            <TextBlock Text="自动恢复会从原播放位置继续；恢复次数耗尽后可跳过损坏、失联或与解码器不兼容的媒体，避免播放器反复卡住。" Style="{StaticResource HintStyle}" Margin="0,0,0,22" />
            <Separator />
            <TextBlock Text="安全播放模式" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,14" />
            <CheckBox Name="SafePlaybackModeCheckBox" Content="启用稳定优先的安全播放模式" Margin="0,0,0,10" />
            <TextBlock Text="开启后实际播放将固定使用 DirectSound、软件解码、关闭可视化与空间音效，并增加媒体缓存；原有音效选择会保留，关闭安全模式后恢复。" Style="{StaticResource HintStyle}" Margin="0,0,0,22" />
            <Separator />
            <TextBlock Text="状态与诊断" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,14" />
            <CheckBox Name="StateBackupCheckBox" Content="每次保存后保留可恢复的曲库与设置备份" Margin="0,0,0,10" />
            <TextBlock Text="如果异常退出或新版状态文件损坏，程序会优先读取最近一次有效备份；旧版 library.json 会自动迁移并与新版隔离。" Style="{StaticResource HintStyle}" Margin="0,0,0,16" />
            <Button Content="打开诊断日志文件夹" Width="190" HorizontalAlignment="Left" Click="OpenLogFolderButton_Click" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="桌面歌词">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,22">
            <TextBlock Text="桌面歌词" Style="{StaticResource SectionTitleStyle}" />
            <WrapPanel Margin="0,0,0,18">
              <CheckBox Name="LyricsTopmostCheckBox" Content="总在最前" Margin="0,0,28,10" />
              <CheckBox Name="ShowTranslationCheckBox" Content="显示第二 / 第三行歌词（音译或中文）" Margin="0,0,28,10" Click="LyricsPreviewSetting_Changed" />
              <CheckBox Name="LyricsLockedCheckBox" Content="锁定位置" Margin="0,0,28,10" />
              <CheckBox Name="LyricsStrokeCheckBox" Content="启用描边" Margin="0,0,28,10" Click="LyricsPreviewSetting_Changed" />
              <CheckBox Name="InPlayerLyricsStyleCheckBox" Content="同步配色到播放器字幕" Margin="0,0,28,10" />
              <CheckBox Name="LyricsClickToActivateCheckBox" Content="专注模式：仅点击歌词后显示控制栏" Margin="0,0,28,10" ToolTip="开启后只有歌词文字可点击，其他区域鼠标穿透；点击歌词后才能操作控制栏，移出歌词窗口后自动恢复穿透" />
            </WrapPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="54" />
                <RowDefinition Height="54" />
                <RowDefinition Height="54" />
                <RowDefinition Height="102" />
                <RowDefinition Height="112" />
                <RowDefinition Height="58" />
              </Grid.RowDefinitions>
              <TextBlock Text="字体" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="LyricsFontCombo" Grid.Column="1" Width="280" HorizontalAlignment="Left" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="LyricsPreviewSetting_Changed" />
              <TextBlock Grid.Column="2" Text="字重" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="LyricsFontWeightCombo" Grid.Column="3" Width="190" HorizontalAlignment="Left" SelectionChanged="LyricsPreviewSetting_Changed">
                <ComboBoxItem Content="标准" Tag="Normal" />
                <ComboBoxItem Content="中等" Tag="Medium" />
                <ComboBoxItem Content="半粗" Tag="SemiBold" />
                <ComboBoxItem Content="粗体" Tag="Bold" />
              </ComboBox>
              <TextBlock Grid.Row="1" Text="原文字号" Style="{StaticResource SettingLabelStyle}" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <Slider Name="LyricsFontSizeSlider" Width="240" Minimum="12" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LyricsFontSizeSlider_ValueChanged" />
                <TextBlock Name="LyricsFontSizeText" Width="50" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="翻译字号（分行）" Style="{StaticResource SettingLabelStyle}" />
              <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                <Slider Name="LyricsTranslationFontSizeSlider" Width="150" Minimum="10" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LyricsTranslationFontSizeSlider_ValueChanged" />
                <TextBlock Name="LyricsTranslationFontSizeText" Width="42" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="显示布局" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="LyricsLayoutCombo" Grid.Row="2" Grid.Column="1" Width="190" HorizontalAlignment="Left" SelectionChanged="LyricsPreviewSetting_Changed">
                <ComboBoxItem Content="原文与翻译分行" Tag="Stacked" />
                <ComboBoxItem Content="原文与翻译单行" Tag="SingleLine" />
              </ComboBox>
              <TextBlock Grid.Row="2" Grid.Column="2" Text="对齐" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="LyricsAlignmentCombo" Grid.Row="2" Grid.Column="3" Width="190" HorizontalAlignment="Left" SelectionChanged="LyricsPreviewSetting_Changed">
                <ComboBoxItem Content="居中" Tag="Center" />
                <ComboBoxItem Content="左对齐" Tag="Left" />
                <ComboBoxItem Content="右对齐" Tag="Right" />
              </ComboBox>
              <TextBlock Grid.Row="3" Text="配色方案" Style="{StaticResource SettingLabelStyle}" />
              <ComboBox Name="LyricsColorCombo" Grid.Row="3" Grid.Column="1" Width="190" HorizontalAlignment="Left" SelectionChanged="LyricsPreviewSetting_Changed">
                <ComboBoxItem Content="薄荷紫" Tag="MintPurple" />
                <ComboBoxItem Content="经典白" Tag="Classic" />
                <ComboBoxItem Content="高对比" Tag="HighContrast" />
                <ComboBoxItem Content="自定义" Tag="Custom" />
              </ComboBox>
              <TextBlock Grid.Row="3" Grid.Column="2" Text="渐变" Style="{StaticResource SettingLabelStyle}" />
              <CheckBox Name="LyricsGradientCheckBox" Grid.Row="3" Grid.Column="3" Content="使用上下渐变" Click="LyricsPreviewSetting_Changed" />
              <TextBlock Grid.Row="4" Text="自定义颜色" Style="{StaticResource SettingLabelStyle}" />
              <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center">
                <Button Name="PrimaryColorButton" Content="原文色" Width="150" Margin="0,0,10,8" Click="PrimaryColorButton_Click" />
                <Button Name="SecondaryColorButton" Content="渐变末端" Width="150" Margin="0,0,10,8" Click="SecondaryColorButton_Click" />
                <Button Name="RomanizationColorButton" Content="音译色" Width="150" Margin="0,0,10,8" Click="RomanizationColorButton_Click" />
                <Button Name="TranslationColorButton" Content="翻译色" Width="150" Margin="0,0,10,8" Click="TranslationColorButton_Click" />
                <Button Name="StrokeColorButton" Content="描边色" Width="150" Margin="0,0,10,8" Click="StrokeColorButton_Click" />
                <TextBlock Text="选色后自动切换到“自定义”" VerticalAlignment="Center" Style="{StaticResource HintStyle}" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBlock Grid.Row="5" Text="文字透明度" Style="{StaticResource SettingLabelStyle}" />
              <WrapPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,10">
                  <TextBlock Text="原文" Width="42" VerticalAlignment="Center" />
                  <Slider Name="LyricsOriginalOpacitySlider" Width="150" Minimum="0.35" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="LyricsOpacitySetting_ValueChanged" />
                  <TextBlock Name="LyricsOriginalOpacityText" Width="48" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,10">
                  <TextBlock Text="音译" Width="42" VerticalAlignment="Center" />
                  <Slider Name="LyricsRomanizationOpacitySlider" Width="150" Minimum="0.35" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="LyricsOpacitySetting_ValueChanged" />
                  <TextBlock Name="LyricsRomanizationOpacityText" Width="48" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,10">
                  <TextBlock Text="翻译" Width="42" VerticalAlignment="Center" />
                  <Slider Name="LyricsTranslationOpacitySlider" Width="150" Minimum="0.35" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="LyricsOpacitySetting_ValueChanged" />
                  <TextBlock Name="LyricsTranslationOpacityText" Width="48" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Grid.Row="6" Text="描边粗细" Style="{StaticResource SettingLabelStyle}" />
              <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                <Slider Name="LyricsStrokeScaleSlider" Width="300" Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="LyricsStrokeScaleSlider_ValueChanged" />
                <TextBlock Name="LyricsStrokeScaleText" Width="60" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <TextBlock Text="分行显示时原文、音译和翻译会使用各自配色；单行布局因三种文字合并为一行，统一使用第一段文字的颜色。" Style="{StaticResource HintStyle}" Margin="0,8,0,0" />
            <TextBlock Text="预览" FontWeight="SemiBold" Margin="0,20,0,10" />
            <Border Background="#171B1A" CornerRadius="8" Height="170" Padding="20">
              <StackPanel VerticalAlignment="Center">
                <local:OutlinedTextBlock x:Name="LyricsPreviewOriginal" Text="夜空のメロディー" FontSize="26" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                <local:OutlinedTextBlock x:Name="LyricsPreviewRomanization" Text="yozora no melody" FontSize="17" TextAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                <local:OutlinedTextBlock x:Name="LyricsPreviewTranslation" Text="夜空中的旋律" FontSize="17" TextAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <Grid Margin="0,22,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="52" />
                <RowDefinition Height="52" />
                <RowDefinition Height="58" />
              </Grid.RowDefinitions>
              <TextBlock Text="交互背景透明度" Style="{StaticResource SettingLabelStyle}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Slider Name="LyricsOpacitySlider" Width="300" Minimum="0.1" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="LyricsOpacitySlider_ValueChanged" />
                <TextBlock Name="LyricsOpacityText" Width="60" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="窗口宽度" Style="{StaticResource SettingLabelStyle}" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <Slider Name="LyricsWidthSlider" Width="300" Minimum="480" Maximum="1600" TickFrequency="40" IsSnapToTickEnabled="True" ValueChanged="LyricsWidthSlider_ValueChanged" />
                <TextBlock Name="LyricsWidthText" Width="80" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="歌词时间偏移" Style="{StaticResource SettingLabelStyle}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <Slider Name="LyricsOffsetSlider" Width="300" Minimum="-5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="LyricsOffsetSlider_ValueChanged" />
                <TextBlock Name="LyricsOffsetText" Width="80" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Row="3" Text="窗口位置" Style="{StaticResource SettingLabelStyle}" />
              <Button Grid.Row="3" Grid.Column="1" Content="重置桌面歌词位置" Width="180" HorizontalAlignment="Left" Click="ResetLyricsPositionButton_Click" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="曲库">
        <Grid Margin="28,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="音乐文件夹" Style="{StaticResource SectionTitleStyle}" />
          <ListBox Name="LibraryFoldersList" Grid.Row="1" MinHeight="300" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceBrush}" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,16">
            <Button Content="添加文件夹" Margin="0,0,8,0" Click="AddLibraryFolderButton_Click" />
            <Button Content="移除所选" Click="RemoveLibraryFolderButton_Click" />
          </StackPanel>
          <CheckBox Name="ScanOnStartupCheckBox" Grid.Row="3" Content="程序启动时重新扫描曲库" />
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="18,0">
        <Button Content="保存并重新扫描" HorizontalAlignment="Left" VerticalAlignment="Center" Click="SaveAndRescanButton_Click" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="取消" Width="88" Margin="0,0,8,0" IsCancel="True" />
          <Button Content="保存" Width="88" Style="{StaticResource AccentButtonStyle}" IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
