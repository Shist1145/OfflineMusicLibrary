          <Slider Name="VolumeSlider" Width="82" Minimum="0" Maximum="100" Margin="2,0,4,0" ValueChanged="VolumeSlider_ValueChanged" />
          <Button Content="•••" Style="{StaticResource PlayerBarButtonStyle}" Width="38" ToolTip="播放器设置" Click="SettingsButton_Click" />
        </StackPanel>
      </Grid>
    </Border>
