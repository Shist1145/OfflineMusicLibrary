                    <TextBlock Name="ImmersiveArtistText" Text="歌手：-" Foreground="#8F8998" FontSize="12" Margin="0,0,24,0" />
                    <TextBlock Name="ImmersiveSourceText" Text="来源：本地文件" Foreground="#8F8998" FontSize="12" />
                  </WrapPanel>
                </StackPanel>

                <TabControl Name="ImmersiveInfoTabs" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" Padding="0">
