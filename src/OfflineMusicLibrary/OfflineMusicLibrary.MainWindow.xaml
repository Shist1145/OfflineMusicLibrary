                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="ImmersiveButtonBorder" Property="Background" Value="#2DFFFFFF" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="ImmersiveButtonBorder" Property="Background" Value="#42FFFFFF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style x:Key="ImmersivePrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ImmersiveCommandButtonStyle}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Background" Value="#FFF5F2F8" />
            <Setter Property="Foreground" Value="#FF17131F" />
            <Setter Property="FontSize" Value="20" />
          </Style>

          <Style x:Key="ImmersiveModeRadioStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="#AAB1AAB8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                  <Border x:Name="ModeCard"
                          Background="#10FFFFFF"
                          BorderBrush="#2AFFFFFF"
                          BorderThickness="1"
                          CornerRadius="9"
                          Padding="8,5">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="ModeCard" Property="Background" Value="#20FFFFFF" />
                      <Setter Property="Foreground" Value="#FFF8F6FA" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="ModeCard" Property="Background" Value="#2DFFFFFF" />
                      <Setter TargetName="ModeCard" Property="BorderBrush" Value="#8AE7C9FF" />
                      <Setter Property="Foreground" Value="#FFFFFFFF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style x:Key="ImmersiveTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#8E8998" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                  <Border x:Name="TabPill" Background="#00FFFFFF" CornerRadius="14" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="TabPill" Property="Background" Value="#14FFFFFF" />
                      <Setter Property="Foreground" Value="#D9D4E0" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="TabPill" Property="Background" Value="#2CFFFFFF" />
                      <Setter Property="Foreground" Value="#FFFFFFFF" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style x:Key="ImmersiveListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                  <Border Background="#00FFFFFF" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <DataTemplate x:Key="ImmersiveStandardLyricTemplate">
            <StackPanel Margin="2,7">
              <local:OutlinedTextBlock Text="{Binding Original}"
                                       Foreground="{DynamicResource ImmersiveOriginalBrush}"
                                       Stroke="{DynamicResource ImmersiveStrokeBrush}"
                                       StrokeThickness="{DynamicResource ImmersiveOriginalStrokeThickness}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left">
                <local:OutlinedTextBlock.Style>
                  <Style TargetType="{x:Type local:OutlinedTextBlock}">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Opacity" Value="0.48" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </local:OutlinedTextBlock.Style>
              </local:OutlinedTextBlock>
              <local:OutlinedTextBlock Text="{Binding Romanization}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ImmersiveRomanizationBrush}"
                                       Stroke="{DynamicResource ImmersiveStrokeBrush}"
                                       StrokeThickness="{DynamicResource ImmersiveRomanizationStrokeThickness}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left"
                                       Margin="0,3,0,0">
                <local:OutlinedTextBlock.Style>
                  <Style TargetType="{x:Type local:OutlinedTextBlock}">
                    <Setter Property="Opacity" Value="0.38" />
                    <Style.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Opacity" Value="0.94" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </local:OutlinedTextBlock.Style>
              </local:OutlinedTextBlock>
              <local:OutlinedTextBlock Text="{Binding Translation}"
                                       FontSize="13"
                                       Foreground="{DynamicResource ImmersiveTranslationBrush}"
                                       Stroke="{DynamicResource ImmersiveStrokeBrush}"
                                       StrokeThickness="{DynamicResource ImmersiveTranslationStrokeThickness}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left"
                                       Margin="0,3,0,0">
                <local:OutlinedTextBlock.Style>
                  <Style TargetType="{x:Type local:OutlinedTextBlock}">
                    <Setter Property="Opacity" Value="0.4" />
                    <Style.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Opacity" Value="0.96" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </local:OutlinedTextBlock.Style>
              </local:OutlinedTextBlock>
            </StackPanel>
          </DataTemplate>

          <DataTemplate x:Key="ImmersiveFocusLyricTemplate">
            <StackPanel Margin="24,14">
              <local:OutlinedTextBlock Text="{Binding Original}"
                                       Foreground="{DynamicResource ImmersiveOriginalBrush}"
                                       Stroke="{DynamicResource ImmersiveStrokeBrush}"
                                       StrokeThickness="{DynamicResource ImmersiveFocusOriginalStrokeThickness}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center">
                <local:OutlinedTextBlock.Style>
                  <Style TargetType="{x:Type local:OutlinedTextBlock}">
                    <Setter Property="FontSize" Value="26" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Opacity" Value="0.28" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="FontSize" Value="31" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </local:OutlinedTextBlock.Style>
              </local:OutlinedTextBlock>
              <local:OutlinedTextBlock Text="{Binding Romanization}"
                                       FontSize="15"
                                       Foreground="{DynamicResource ImmersiveRomanizationBrush}"
                                       Stroke="{DynamicResource ImmersiveStrokeBrush}"
                                       StrokeThickness="{DynamicResource ImmersiveFocusRomanizationStrokeThickness}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0">
                <local:OutlinedTextBlock.Style>
                  <Style TargetType="{x:Type local:OutlinedTextBlock}">
                    <Setter Property="Opacity" Value="0.22" />
                    <Style.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Opacity" Value="0.94" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </local:OutlinedTextBlock.Style>
              </local:OutlinedTextBlock>
              <local:OutlinedTextBlock Text="{Binding Translation}"
                                       FontSize="17"
                                       Foreground="{DynamicResource ImmersiveTranslationBrush}"
                                       Stroke="{DynamicResource ImmersiveStrokeBrush}"
                                       StrokeThickness="{DynamicResource ImmersiveFocusTranslationStrokeThickness}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0">
                <local:OutlinedTextBlock.Style>
                  <Style TargetType="{x:Type local:OutlinedTextBlock}">
                    <Setter Property="Opacity" Value="0.24" />
                    <Style.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Opacity" Value="0.96" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </local:OutlinedTextBlock.Style>
              </local:OutlinedTextBlock>
            </StackPanel>
          </DataTemplate>
        </Grid.Resources>

        <Image Name="ImmersiveBackgroundImage"
               Margin="-58"
               Stretch="UniformToFill"
               Opacity="0.22"
               CacheMode="BitmapCache"
               IsHitTestVisible="False">
