<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="OfflineMusicLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:OfflineMusicLibrary"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="本地音乐库"
        Icon="Assets/OfflineMusicLibrary-logo.ico"
        Width="1440" Height="880"
        MinWidth="1120" MinHeight="700"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="68"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Grid Name="MainRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="68" />
      <RowDefinition Height="*" />
      <RowDefinition Height="94" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1E2026" BorderBrush="#343842" BorderThickness="0,0,0,1">
      <Border.Resources>
        <Style x:Key="HeaderIconButtonStyle" TargetType="{x:Type Button}">
          <Setter Property="Width" Value="36" />
          <Setter Property="Height" Value="34" />
          <Setter Property="Margin" Value="2,0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Foreground" Value="#CBD1DA" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="FontFamily" Value="Segoe UI Symbol" />
          <Setter Property="FontSize" Value="15" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border x:Name="HeaderButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HeaderButtonBorder" Property="Background" Value="#343842" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="HeaderButtonBorder" Property="Background" Value="#464B57" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="HeaderTextButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource HeaderIconButtonStyle}">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Padding" Value="11,0" />
          <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
          <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource HeaderIconButtonStyle}">
          <Setter Property="Width" Value="42" />
          <Setter Property="Height" Value="68" />
          <Setter Property="Margin" Value="0" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border x:Name="CaptionButtonBorder" Background="{TemplateBinding Background}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="CaptionButtonBorder" Property="Background" Value="#343842" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="CaptionButtonBorder" Property="Background" Value="#4A4F5B" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButtonStyle}">
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#D93A4D" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Resources>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Background="#C93649" Padding="20,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="38" Height="38" Background="#FFF7F8" CornerRadius="9">
              <Image Margin="4" Source="Assets/OfflineMusicLibrary-logo.png" Stretch="Uniform" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Name="AppTitleTextBlock"
                         Text="OfflineMusicLibrary"
                         Foreground="#FFFFFFFF"
                         FontFamily="Segoe UI"
                         FontSize="15"
                         FontWeight="SemiBold" />
              <TextBlock Text="LOCAL MUSIC PLAYER"
                         Foreground="#DDF6E6E8"
                         FontFamily="Segoe UI"
                         FontSize="8.5"
                         Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Grid Grid.Column="1"
              MaxWidth="430"
              MinWidth="220"
              Margin="22,0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Border Height="38"
                  Background="#282B33"
                  BorderBrush="#3C414C"
                  BorderThickness="1"
                  CornerRadius="19">
            <Grid>
              <TextBlock Text="⌕"
                         Foreground="#929BA8"
                         FontSize="19"
                         Margin="13,0,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />
              <TextBox Name="SearchBox"
                       Height="36"
                       Margin="34,0,13,0"
                       Padding="0"
                       Background="#00FFFFFF"
                       Foreground="#F2F4F7"
                       BorderThickness="0"
                       CaretBrush="#FFFFFFFF"
                       VerticalContentAlignment="Center"
                       ToolTip="搜索歌曲、社团、艺术家、专辑、分类或文件名"
                       TextChanged="SearchBox_TextChanged" />
              <TextBlock Name="SearchHint"
                         Text="搜索本地歌曲、艺人、专辑…"
                         Foreground="#7F8996"
                         Margin="35,0,10,0"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />
            </Grid>
          </Border>
        </Grid>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Name="MiniModeButton"
                  Content="▣ MINI"
                  Style="{StaticResource HeaderTextButtonStyle}"
                  Foreground="#FF7080"
                  ToolTip="切换到迷你播放器 (Ctrl + Shift + M)"
                  Click="MiniModeButton_Click" />
          <Button Name="OpenMediaButton"
                  Content="＋"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  ToolTip="打开媒体文件"
                  Click="OpenMediaButton_Click" />
          <Button Name="AddFolderButton"
                  Content="▤"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  ToolTip="添加音乐文件夹"
                  Click="AddFolderButton_Click" />
          <Button Name="RescanButton"
                  Content="↻"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  ToolTip="重新扫描曲库"
                  Click="RescanButton_Click" />
          <Button Name="ImportNetEaseButton"
                  Content="网易云 ▾"
                  Style="{StaticResource HeaderTextButtonStyle}"
                  ToolTip="导入网易云歌单或播放历史"
                  Click="NetEaseImportMenuButton_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="导入歌单…" Click="ImportNetEaseButton_Click" />
                <MenuItem Header="导入播放历史…" Click="ImportNetEaseHistoryButton_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Content="⚙"
                  Style="{StaticResource HeaderIconButtonStyle}"
                  ToolTip="设置"
                  Click="SettingsButton_Click" />
          <Border Width="1" Height="24" Background="#3A3E48" Margin="5,0,1,0" />
          <Button Content="—"
                  Style="{StaticResource CaptionButtonStyle}"
                  ToolTip="最小化"
                  Click="MinimizeWindowButton_Click" />
          <Button Name="MaximizeRestoreButton"
                  Content="□"
                  Style="{StaticResource CaptionButtonStyle}"
                  ToolTip="最大化 / 还原"
                  Click="MaximizeRestoreWindowButton_Click" />
          <Button Content="×"
                  Style="{StaticResource CloseCaptionButtonStyle}"
                  ToolTip="关闭"
                  Click="CloseWindowButton_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="12,16,12,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ListBox Name="SidebarList" Grid.Row="0" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="SidebarList_SelectionChanged">
            <ItemsControl.ItemContainerStyle>
              <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="7,4" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsHeader}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,8,0,2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <TextBlock Name="LibrarySectionLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="10,2,0,5" Visibility="Collapsed" Text="{Binding Title}" />
                  <Grid Name="LibraryItem" MinHeight="36" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="25" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="Segoe UI Symbol" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Icon}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                    <TextBlock Grid.Column="2" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" Margin="6,0,2,0" VerticalAlignment="Center" Text="{Binding CountText}" />
                  </Grid>
                  <Grid Name="SectionHeader" MinHeight="34" Visibility="Collapsed">
                    <Button Background="#00FFFFFF" BorderThickness="0" Padding="8,4" HorizontalContentAlignment="Stretch" Click="SidebarSectionButton_Click">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="18" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Text="{Binding ExpansionGlyph}" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Title}" />
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" Margin="7,0,0,0" VerticalAlignment="Center" Text="{Binding CountText}" />
                      </Grid>
                    </Button>
                    <StackPanel Name="PlaylistHeaderActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed">
                      <Button Content="＋" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" FontSize="14" ToolTip="新建歌单" Click="CreatePlaylistButton_Click" />
                      <Button Content="✎" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" FontSize="13" Margin="2,0,0,0" ToolTip="编辑歌单封面、名称、标签和简介" Click="RenamePlaylistButton_Click" />
                      <Button Content="×" Style="{StaticResource IconButtonStyle}" Width="27" Height="27" FontSize="16" Margin="2,0,0,0" ToolTip="删除歌单" Click="DeletePlaylistButton_Click" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Name="CategoryItem" TextTrimming="CharacterEllipsis" MinHeight="28" VerticalAlignment="Center" Visibility="Collapsed" Text="{Binding Category}" />
                  <Grid Name="PlaylistItem" MinHeight="46" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Border Background="{DynamicResource CoverFallbackBrush}" CornerRadius="5">
                        <TextBlock Text="♫" FontSize="17" Foreground="{DynamicResource CoverGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Border CornerRadius="5" ClipToBounds="True">
                        <Image Stretch="UniformToFill" Source="{Binding Playlist.CoverThumbnail}" />
                      </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Playlist.Name}" />
                      <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" Margin="0,2,0,0" Text="{Binding Playlist.CountText}" />
                    </StackPanel>
                  </Grid>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Value="LibraryHeader" Binding="{Binding Kind}">
                    <Setter TargetName="LibrarySectionLabel" Property="UIElement.Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="LibraryItem" Binding="{Binding Kind}">
                    <Setter TargetName="LibraryItem" Property="UIElement.Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="CategoryHeader" Binding="{Binding Kind}">
                    <Setter TargetName="SectionHeader" Property="UIElement.Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="PlaylistHeader" Binding="{Binding Kind}">
                    <Setter TargetName="SectionHeader" Property="UIElement.Visibility" Value="Visible" />
                    <Setter TargetName="PlaylistHeaderActions" Property="UIElement.Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="Category" Binding="{Binding Kind}">
                    <Setter TargetName="CategoryItem" Property="UIElement.Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Value="Playlist" Binding="{Binding Kind}">
                    <Setter TargetName="PlaylistItem" Property="UIElement.Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Grid Column="1" Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="46" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="18,0" MinHeight="58">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid>
            <StackPanel Name="StandardHeaderPanel" VerticalAlignment="Center">
              <TextBlock Name="CurrentViewTitle" Text="全部音乐" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Name="StatusText" Text="正在准备曲库…" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <Grid Name="PlaylistHeaderPanel" Visibility="Collapsed" Margin="0,12,18,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="84" Height="84" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Background="{DynamicResource CoverFallbackBrush}" CornerRadius="7">
                  <TextBlock Text="♫" FontSize="30" Foreground="{DynamicResource CoverGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="7" ClipToBounds="True">
                  <Image Name="PlaylistHeaderCoverImage" Stretch="UniformToFill" />
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Name="PlaylistHeaderTitleText" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Button Content="✎ 编辑资料" Padding="9,4" Margin="10,0,0,0" Click="EditPlaylistButton_Click" />
                  <Button Content="▶ 播放全部" Padding="9,4" Margin="7,0,0,0" Click="PlaylistPlayAllButton_Click" />
                </StackPanel>
                <TextBlock Name="PlaylistHeaderDescriptionText" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                <TextBlock Name="PlaylistHeaderTagsText" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                <TextBlock Name="PlaylistHeaderMetaText" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Text="{Binding Text, ElementName=StatusText}" />
              </StackPanel>
            </Grid>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,14,0">
              <StackPanel Orientation="Horizontal">
                <Button Name="LibraryViewButton" Content="曲库" Padding="12,5" BorderThickness="0" ToolTip="显示媒体资料库" Click="LibraryViewButton_Click" />
                <Button Name="PlayerViewButton" Content="播放器" Padding="12,5" BorderThickness="1,0,0,0" ToolTip="显示视频画面或音频可视化" Click="PlayerViewButton_Click" />
              </StackPanel>
            </Border>
            <TextBlock Name="TrackCountText" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
          </StackPanel>
        </Grid>
        <Border Name="LibraryToolbar" Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1">
          <Grid Margin="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="添加到…" Padding="10,5" Margin="0,0,6,0" ToolTip="加入一个或多个歌单、下一首或播放队列" Click="AddToPlaylistButton_Click" />
              <Button Content="添加分类" Padding="10,5" Margin="0,0,6,0" Click="AddCategoryButton_Click" />
              <Button Content="移除分类" Padding="10,5" Margin="0,0,6,0" Click="RemoveCategoryButton_Click" />
              <Button Content="切换歌曲收藏" Padding="10,5" Margin="0,0,6,0" Click="ToggleFavoriteButton_Click" />
              <Button Content="切换专辑收藏" Padding="10,5" Margin="0,0,6,0" Click="ToggleAlbumFavoriteButton_Click" />
              <Button Name="RemoveFromPlaylistButton" Content="移出歌单" Padding="10,5" Visibility="Collapsed" Click="RemoveFromPlaylistButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Text="排序" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
              <ComboBox Name="SortCombo" Width="138" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged">
                <ComboBoxItem Content="推荐顺序" Tag="RecommendationRank" />
                <ComboBoxItem Content="艺术家 / 专辑" Tag="ArtistAlbum" />
                <ComboBoxItem Content="歌曲名称" Tag="Title" />
                <ComboBoxItem Content="最近添加" Tag="AddedAt" />
                <ComboBoxItem Content="最近播放" Tag="LastPlayedAt" />
                <ComboBoxItem Content="播放次数" Tag="PlayCount" />
                <ComboBoxItem Content="曲目编号" Tag="TrackNumber" />
                <ComboBoxItem Content="收藏状态" Tag="IsFavorite" />
                <ComboBoxItem Content="艺术家" Tag="Artist" />
                <ComboBoxItem Content="专辑" Tag="Album" />
                <ComboBoxItem Content="社团" Tag="CircleText" />
                <ComboBoxItem Content="分类" Tag="CategoryText" />
                <ComboBoxItem Content="时长" Tag="DurationMs" />
                <ComboBoxItem Content="格式" Tag="Format" />
              </ComboBox>
            </StackPanel>
          </Grid>
        </Border>
        <Border Name="RecommendationToolbar" Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1" Visibility="Collapsed">
          <Grid Margin="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,100,0">
              <Button Name="RecommendationHomeButton" Content="‹  推荐首页" Padding="11,5" Margin="0,0,7,0" Click="RecommendationHomeButton_Click" />
              <Button Content="很久没听" Tag="RediscoverFavorites" Padding="10,5" Margin="0,0,7,0" Click="RecommendationPresetButton_Click" />
              <Button Content="从未播放" Tag="UnplayedGems" Padding="10,5" Margin="0,0,7,0" Click="RecommendationPresetButton_Click" />
              <Button Content="收藏延伸" Tag="FavoriteExpansion" Padding="10,5" Margin="0,0,7,0" Click="RecommendationPresetButton_Click" />
              <Button Content="30 分钟" Tag="ThirtyMinuteRadio" Padding="10,5" Click="RecommendationPresetButton_Click" />
            </StackPanel>
            <Button Name="RefreshRecommendationButton" Content="↻  换一批" Padding="11,5" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshRecommendationButton_Click" />
          </Grid>
        </Border>
        <Border Name="AlbumToolbar" Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1" Visibility="Collapsed">
          <Grid Margin="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Name="AllAlbumsFilterButton" Content="全部专辑" Padding="14,5" Margin="0,0,8,0" Click="AllAlbumsFilterButton_Click" />
              <Button Name="FavoriteAlbumsFilterButton" Content="收藏专辑" Padding="14,5" Margin="0,0,8,0" Click="FavoriteAlbumsFilterButton_Click" />
            </StackPanel>
            <TextBlock Text="使用顶部搜索框过滤专辑" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Grid Name="AlbumPanel" Row="2" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}">
          <ListBox Name="AlbumGridList" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="AlbumGridList_SelectionChanged" ScrollViewer.ScrollChanged="AlbumGridList_ScrollChanged">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="8" />
                <Setter Property="Width" Value="214" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="214">
                  <FrameworkElement.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="◎  查看专辑" Click="AlbumContextOpen_Click" />
                      <MenuItem Header="▶  播放整张专辑" Click="AlbumContextPlay_Click" />
                      <MenuItem Header="≡  下一首播放整张专辑" Click="AlbumContextPlayNext_Click" />
                      <Separator />
                      <MenuItem Header="♡  切换专辑收藏" Click="AlbumContextFavorite_Click" />
                      <MenuItem Header="✎  设置整张专辑社团" Click="AlbumContextSetCircle_Click" />
                      <MenuItem Header="↗  分享（复制专辑文件）" Click="AlbumContextShare_Click" />
                      <MenuItem Header="＋  添加全部到…" Click="AlbumContextAddPlaylist_Click" />
                      <Separator />
                      <MenuItem Header="▣  复制专辑信息" Click="AlbumContextCopy_Click" />
                      <MenuItem Header="▱  打开文件所在目录" Click="AlbumContextOpenFolder_Click" />
                    </ContextMenu>
                  </FrameworkElement.ContextMenu>
                  <Grid Width="204" Height="204" HorizontalAlignment="Left">
                    <Border Background="{DynamicResource CoverFallbackBrush}" CornerRadius="8">
                      <TextBlock Text="♫" FontSize="54" Foreground="{DynamicResource CoverGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="8" ClipToBounds="True">
                      <Image Stretch="UniformToFill" Source="{Binding CoverThumbnail}" />
                    </Border>
