                <ColumnDefinition Width="0.47*" />
                <ColumnDefinition Width="0.53*" />
              </Grid.ColumnDefinitions>

              <Viewbox Grid.Column="0" Stretch="Uniform" MaxWidth="520" MaxHeight="520" Margin="0,0,28,0">
