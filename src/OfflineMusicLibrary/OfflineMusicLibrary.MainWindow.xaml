            <BlurEffect x:Name="ImmersiveBackgroundBlur" Radius="38" KernelType="Gaussian" />
          </Image.Effect>
        </Image>
        <Border IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#F2161521" Offset="0" />
              <GradientStop Color="#E312111B" Offset="0.48" />
              <GradientStop Color="#F10E0D16" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <Grid>
