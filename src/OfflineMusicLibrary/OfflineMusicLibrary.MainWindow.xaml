                          </Grid>
                        </Border>
                        <TextBlock Text="媒体规格" Foreground="#777181" FontSize="11" Margin="0,18,0,4" />
                        <TextBlock Name="ImmersiveTechnicalText" Text="尚未读取媒体流信息" Foreground="#A39DAC" FontFamily="Consolas" FontSize="11.5" LineHeight="19" TextWrapping="Wrap" />
