                      </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Margin="22" Stroke="#25FFFFFF" StrokeThickness="1" />
                    <Ellipse Margin="38" Stroke="#14FFFFFF" StrokeThickness="1" />
                    <Ellipse Margin="55" Stroke="#20FFFFFF" StrokeThickness="1" />
                    <Ellipse Margin="72" Stroke="#12FFFFFF" StrokeThickness="1" />
                    <Ellipse Margin="89" Stroke="#20FFFFFF" StrokeThickness="1" />
                    <Ellipse Margin="106" Stroke="#14FFFFFF" StrokeThickness="1" />
                    <Ellipse Margin="123" Stroke="#20FFFFFF" StrokeThickness="1" />
                    <Ellipse Width="220" Height="220" Fill="#30303A" />
                    <TextBlock Text="♫" Foreground="#686573" FontSize="74" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Name="VinylFocusCoverImage" Width="220" Height="220" Stretch="UniformToFill">
                      <Image.Clip>
                        <EllipseGeometry Center="110,110" RadiusX="110" RadiusY="110" />
                      </Image.Clip>
                    </Image>
                    <Ellipse Width="16" Height="16" Fill="#F0ECF3" Stroke="#6A6472" StrokeThickness="2" />
                  </Grid>
                  <Grid Width="190" Height="258" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" RenderTransformOrigin="0.82,0.09">
                    <Grid.RenderTransform>
                      <RotateTransform x:Name="VinylFocusTonearmTransform" Angle="-22" />
                    </Grid.RenderTransform>
                    <Canvas Width="190" Height="258">
                      <Ellipse Canvas.Left="137" Canvas.Top="5" Width="44" Height="44" Fill="#ECEBF0" Stroke="#5B5762" StrokeThickness="6" />
                      <Path Data="M 158,27 C 155,88 127,144 61,195" Stroke="#F2F2F5" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      <Path Data="M 158,27 C 155,88 127,144 61,195" Stroke="#9C99A3" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      <Border Canvas.Left="34" Canvas.Top="187" Width="44" Height="21" Background="#F4F2F7" CornerRadius="3" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                          <RotateTransform Angle="-18" />
                        </Border.RenderTransform>
                      </Border>
                    </Canvas>
                  </Grid>
                </Grid>
              </Viewbox>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="380">
                <TextBlock Text="正在播放" Foreground="#756F7D" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Name="VinylModeTitleText" Text="尚未播放" Foreground="#FFFDFEFF" FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Name="VinylModeArtistText" Text="从曲库中选择一首歌曲" Foreground="#918A9A" FontSize="14" Margin="0,7,0,0" TextWrapping="Wrap" />
                <Border Height="1" Background="#25FFFFFF" Margin="0,24,0,22" />
                <StackPanel Name="VinylCurrentLyricPanel">
                  <local:OutlinedTextBlock x:Name="VinylCurrentOriginalText" Foreground="#FFFFFFFF" Stroke="#FF050509" StrokeThickness="2" FontSize="25" FontWeight="SemiBold" TextAlignment="Left" TextWrapping="Wrap" />
                  <local:OutlinedTextBlock x:Name="VinylCurrentTranslationText" Foreground="#FFAEE8D0" Stroke="#FF050509" StrokeThickness="1.5" FontSize="17" TextAlignment="Left" TextWrapping="Wrap" Margin="0,8,0,0" />
                  <local:OutlinedTextBlock x:Name="VinylCurrentTertiaryText" Foreground="#FFC9B7FF" Stroke="#FF050509" StrokeThickness="1.4" FontSize="15" TextAlignment="Left" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
                <TextBlock Name="VinylLyricHintText" Text="歌词会随播放自动滚动" Foreground="#5F5A68" FontSize="11" Margin="0,18,0,0" />
              </StackPanel>
            </Grid>

            <Grid Name="LyricsPlayerModePanel" Visibility="Collapsed" Margin="70,0,70,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,36,0">
                <Grid Width="198" Height="198" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                  <Grid.RenderTransform>
                    <RotateTransform x:Name="LyricsModeDiscRotateTransform" />
                  </Grid.RenderTransform>
                  <Ellipse Fill="#09090D" Stroke="#403947" StrokeThickness="8" />
                  <Ellipse Margin="16" Stroke="#1EFFFFFF" StrokeThickness="1" />
                  <Ellipse Margin="31" Stroke="#16FFFFFF" StrokeThickness="1" />
                  <Ellipse Margin="46" Stroke="#20FFFFFF" StrokeThickness="1" />
                  <Ellipse Width="108" Height="108" Fill="#30303A" />
                  <TextBlock Text="♫" Foreground="#6B6675" FontSize="37" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Name="LyricsModeCoverImage" Width="108" Height="108" Stretch="UniformToFill">
                    <Image.Clip>
                      <EllipseGeometry Center="54,54" RadiusX="54" RadiusY="54" />
                    </Image.Clip>
                  </Image>
                </Grid>
                <TextBlock Name="LyricsModeTitleText" Text="尚未播放" Foreground="#F6F3F8" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,20,0,0" />
                <TextBlock Name="LyricsModeArtistText" Text="-" Foreground="#817A89" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                <Border Background="#15FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,18,0,0" HorizontalAlignment="Left">
                  <TextBlock Text="单击歌词可跳转进度" Foreground="#88818F" FontSize="10.5" />
                </Border>
              </StackPanel>
              <Grid Grid.Column="1">
                <ListBox Name="ImmersiveFocusLyricsList"
                         Background="#00FFFFFF"
                         BorderThickness="0"
                         Foreground="#FFFFFFFF"
                         ItemContainerStyle="{StaticResource ImmersiveListItemStyle}"
                         ItemTemplate="{StaticResource ImmersiveFocusLyricTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         Cursor="Hand"
                         PreviewMouseLeftButtonUp="LyricsList_PreviewMouseLeftButtonUp" />
                <TextBlock Name="ImmersiveFocusLyricsEmptyText" Text="这首歌曲暂时没有可显示的歌词" Foreground="#6D6675" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <Border Grid.Column="2" Width="1" Background="#18FFFFFF" HorizontalAlignment="Right" Margin="0,30,0,30" />
            </Grid>

            <Border Name="ImmersiveQueueDrawer"
                    Panel.ZIndex="8"
                    Width="390"
                    HorizontalAlignment="Right"
                    Margin="0,8,20,12"
                    Padding="17"
                    Background="#F31B1924"
                    BorderBrush="#3EFFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="Collapsed">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,12">
                  <StackPanel>
                    <TextBlock Text="当前播放队列" Foreground="#F2EFF5" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="双击歌曲立即播放" Foreground="#716B79" FontSize="10.5" Margin="0,3,0,0" />
                  </StackPanel>
                  <Button Content="×" Style="{StaticResource ImmersiveCommandButtonStyle}" Width="34" Height="34" HorizontalAlignment="Right" Click="ImmersiveQueueCloseButton_Click" />
                </Grid>
                <ListBox Name="ImmersiveQueueList" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" ItemContainerStyle="{StaticResource ImmersiveListItemStyle}" MouseDoubleClick="ImmersiveQueueList_MouseDoubleClick">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#0DFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,0,0,7">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid Width="40" Height="40">
                            <Ellipse Fill="#302E38" />
                            <TextBlock Text="♫" Foreground="#746E7C" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding CoverThumbnail}" Stretch="UniformToFill">
                              <Image.Clip>
                                <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                              </Image.Clip>
                            </Image>
                          </Grid>
                          <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="#EAE7ED" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" Foreground="#746E7C" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#6D6774" FontSize="10.5" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Row="2" Background="#E815131E" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0">
            <Grid Margin="30,9,30,10">
              <Grid.RowDefinitions>
                <RowDefinition Height="31" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="ImmersiveElapsedText" Text="0:00" Foreground="#77717F" FontSize="10.5" VerticalAlignment="Center" />
                <Slider Name="ImmersivePositionSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        Margin="8,0"
                        IsMoveToPointEnabled="True"
                        PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp"
                        ValueChanged="PositionSlider_ValueChanged" />
                <TextBlock Name="ImmersiveDurationText" Grid.Column="2" Text="0:00" Foreground="#77717F" FontSize="10.5" TextAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="360" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid Width="48" Height="48" VerticalAlignment="Center">
                    <Ellipse Fill="#2D2A34" />
                    <TextBlock Text="♫" Foreground="#716B78" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Name="ImmersiveMiniCoverImage" Stretch="UniformToFill">
                      <Image.Clip>
                        <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                      </Image.Clip>
                    </Image>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                    <TextBlock Name="ImmersiveBottomTitleText" Text="未选择歌曲" Foreground="#F0EDF3" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Name="ImmersiveBottomArtistText" Text="-" Foreground="#746E7B" FontSize="10.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Name="ImmersiveShuffleButton" Content="⇄" Style="{StaticResource ImmersiveCommandButtonStyle}" ToolTip="随机播放" Click="ShuffleButton_Click" />
                  <Button Content="◀|" Style="{StaticResource ImmersiveCommandButtonStyle}" ToolTip="上一首" Click="PreviousButton_Click" />
                  <Button Name="ImmersivePlayPauseButton" Content="▶" Style="{StaticResource ImmersivePrimaryButtonStyle}" ToolTip="播放 / 暂停" Click="PlayPauseButton_Click" />
                  <Button Content="|▶" Style="{StaticResource ImmersiveCommandButtonStyle}" ToolTip="下一首" Click="NextButton_Click" />
                  <Button Name="ImmersiveRepeatButton" Content="↻" Style="{StaticResource ImmersiveCommandButtonStyle}" ToolTip="循环模式" Click="RepeatButton_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Name="ImmersiveFavoriteButton" Content="♡" Style="{StaticResource ImmersiveCommandButtonStyle}" Foreground="#FFE15D72" ToolTip="收藏当前歌曲" Click="BottomFavoriteButton_Click" />
                  <Button Content="＋" Style="{StaticResource ImmersiveCommandButtonStyle}" ToolTip="添加到歌单" Click="AddCurrentTrackButton_Click" />
                  <Button Content="☷" Style="{StaticResource ImmersiveCommandButtonStyle}" ToolTip="当前播放队列" Click="ImmersiveQueueButton_Click" />
                  <CheckBox Name="ImmersiveDesktopLyricsCheckBox"
                            Content="词"
                            Foreground="#D8D4DE"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            ToolTip="桌面歌词"
                            Checked="DesktopLyricsCheckBox_Changed"
                            Unchecked="DesktopLyricsCheckBox_Changed" />
                  <TextBlock Text="◖" Foreground="#CFCAD5" FontSize="18" VerticalAlignment="Center" Margin="8,0,2,0" />
                  <Slider Name="ImmersiveVolumeSlider"
                          Width="82"
                          Minimum="0"
                          Maximum="100"
                          Margin="2,0,4,0"
                          Value="76"
                          ValueChanged="VolumeSlider_ValueChanged" />
                  <Button Content="•••" Style="{StaticResource ImmersiveCommandButtonStyle}" ToolTip="播放器设置" Click="SettingsButton_Click" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
