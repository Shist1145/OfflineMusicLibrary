                               BorderThickness="0"
                               Foreground="#FFFFFFFF"
                               ItemContainerStyle="{StaticResource ImmersiveListItemStyle}"
                               ItemTemplate="{StaticResource ImmersiveStandardLyricTemplate}"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               ScrollViewer.VerticalScrollBarVisibility="Hidden"
                               Cursor="Hand"
                               PreviewMouseLeftButtonUp="LyricsList_PreviewMouseLeftButtonUp" />
