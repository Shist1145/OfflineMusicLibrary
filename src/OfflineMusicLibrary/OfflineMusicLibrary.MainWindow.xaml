                                  </Image>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Title}" Foreground="#ECE9F0" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Artist}" Foreground="#777181" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
