                    <TextBlock Text="♫" Foreground="#6E7180" FontSize="62" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Name="StandardVinylCoverImage" Width="184" Height="184" Stretch="UniformToFill">
                      <Image.Clip>
                        <EllipseGeometry Center="92,92" RadiusX="92" RadiusY="92" />
                      </Image.Clip>
                    </Image>
                    <Ellipse Width="14" Height="14" Fill="#E5E0EB" Stroke="#6D6675" StrokeThickness="2" />
                  </Grid>
                  <Grid Name="StandardTonearm" Width="184" Height="240" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,2,0" RenderTransformOrigin="0.82,0.09">
                    <Grid.RenderTransform>
                      <RotateTransform x:Name="StandardTonearmTransform" Angle="-22" />
                    </Grid.RenderTransform>
                    <Canvas Width="184" Height="240">
                      <Ellipse Canvas.Left="132" Canvas.Top="4" Width="42" Height="42" Fill="#E9E8ED" Stroke="#5D5965" StrokeThickness="6" />
                      <Path Data="M 151,25 C 149,82 124,132 61,178" Stroke="#EFF0F3" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      <Path Data="M 151,25 C 149,82 124,132 61,178" Stroke="#A9A6AF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      <Border Canvas.Left="35" Canvas.Top="170" Width="42" Height="20" Background="#F3F1F6" CornerRadius="3" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                          <RotateTransform Angle="-18" />
                        </Border.RenderTransform>
                      </Border>
                      <Border Canvas.Left="31" Canvas.Top="182" Width="18" Height="9" Background="#BFC0C8" CornerRadius="2" />
                    </Canvas>
