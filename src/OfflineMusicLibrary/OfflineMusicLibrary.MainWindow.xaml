                      <RotateTransform x:Name="StandardVinylRotateTransform" />
                    </Grid.RenderTransform>
                    <Ellipse Stroke="#443B4758" StrokeThickness="10">
                      <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.34,0.3" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                          <GradientStop Color="#FF3A3A42" Offset="0" />
                          <GradientStop Color="#FF17171C" Offset="0.45" />
                          <GradientStop Color="#FF050508" Offset="0.82" />
                          <GradientStop Color="#FF1D1D23" Offset="1" />
