            <Button Content="|▶" Style="{StaticResource PlayerBarButtonStyle}" ToolTip="下一首 (Ctrl + Right)" Click="NextButton_Click" />
            <Button Name="RepeatButton" Content="↻" Style="{StaticResource PlayerBarButtonStyle}" ToolTip="循环模式" Click="RepeatButton_Click" />
            <Button Content="☷" Style="{StaticResource PlayerBarButtonStyle}" ToolTip="当前播放队列" Click="OpenQueueButton_Click" />
