                            <StackPanel>
                              <TextBlock Text="艺术家" Foreground="#686270" FontSize="11" />
                              <TextBlock Text="专辑" Foreground="#686270" FontSize="11" Margin="0,13,0,0" />
                              <TextBlock Text="来源" Foreground="#686270" FontSize="11" Margin="0,13,0,0" />
                              <TextBlock Text="分类" Foreground="#686270" FontSize="11" Margin="0,13,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBlock Name="ImmersiveInfoArtistValueText" Text="-" Foreground="#D9D5DF" FontSize="12" TextTrimming="CharacterEllipsis" />
                              <TextBlock Name="ImmersiveInfoAlbumValueText" Text="-" Foreground="#D9D5DF" FontSize="12" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                              <TextBlock Name="ImmersiveInfoSourceValueText" Text="-" Foreground="#D9D5DF" FontSize="12" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                              <TextBlock Name="ImmersiveInfoCategoryValueText" Text="-" Foreground="#D9D5DF" FontSize="12" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
