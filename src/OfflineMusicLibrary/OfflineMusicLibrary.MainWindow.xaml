                  <TextBlock Text="歌词" FontSize="11.5" Margin="0,3,0,0" HorizontalAlignment="Center" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
