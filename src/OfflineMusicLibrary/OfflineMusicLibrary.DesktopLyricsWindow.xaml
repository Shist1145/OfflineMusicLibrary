<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="OfflineMusicLibrary.DesktopLyricsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OfflineMusicLibrary" Title="桌面歌词" Width="760" Height="184" MinWidth="480" MinHeight="144" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual" MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" LocationChanged="Window_LocationChanged">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="LyricToolbarButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="ButtonBorder" Background="{TemplateBinding Control.Background}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Border.Background" Value="#35FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Border.Background" Value="#55FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="RootBorder" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="1" CornerRadius="6" Padding="14,7">
    <FrameworkElement.ContextMenu>
      <ContextMenu>
        <MenuItem Header="上一首" Click="PreviousButton_Click" />
        <MenuItem Header="播放 / 暂停" Click="PlayPauseButton_Click" />
        <MenuItem Header="下一首" Click="NextButton_Click" />
        <Separator />
        <MenuItem Header="歌词语言">
          <MenuItem Header="原文 + 中文" Tag="OriginalTranslation" Click="LyricsModeMenuItem_Click" />
          <MenuItem Header="原文 + 音译" Tag="OriginalRomanization" Click="LyricsModeMenuItem_Click" />
          <MenuItem Header="音译 + 中文" Tag="RomanizationTranslation" Click="LyricsModeMenuItem_Click" />
          <MenuItem Header="三语同时显示" Tag="All" Click="LyricsModeMenuItem_Click" />
          <Separator />
          <MenuItem Header="只看原文" Tag="OriginalOnly" Click="LyricsModeMenuItem_Click" />
          <MenuItem Header="只看音译" Tag="RomanizationOnly" Click="LyricsModeMenuItem_Click" />
          <MenuItem Header="只看中文" Tag="TranslationOnly" Click="LyricsModeMenuItem_Click" />
        </MenuItem>
        <MenuItem Name="LockMenuItem" Header="锁定位置" IsCheckable="True" Click="LockMenuItem_Click" />
        <MenuItem Header="歌词设置" Click="SettingsButton_Click" />
        <Separator />
        <MenuItem Header="关闭桌面歌词" Click="CloseButton_Click" />
      </ContextMenu>
    </FrameworkElement.ContextMenu>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Name="Toolbar" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
        <Button Content="♪" Style="{StaticResource LyricToolbarButton}" ToolTip="打开主窗口" Click="ActivateMainButton_Click" />
        <Button Content="−0.5s" Style="{StaticResource LyricToolbarButton}" ToolTip="歌词提前 0.5 秒" FontFamily="Microsoft YaHei UI" FontSize="12" Click="OffsetEarlierButton_Click" />
        <Button Content="+0.5s" Style="{StaticResource LyricToolbarButton}" ToolTip="歌词延后 0.5 秒" FontFamily="Microsoft YaHei UI" FontSize="12" Click="OffsetLaterButton_Click" />
        <Button Content="|◀" Style="{StaticResource LyricToolbarButton}" ToolTip="上一首" Click="PreviousButton_Click" />
        <Button Name="ToolbarPlayPauseButton" Content="▶" Style="{StaticResource LyricToolbarButton}" ToolTip="播放 / 暂停" Click="PlayPauseButton_Click" />
        <Button Content="▶|" Style="{StaticResource LyricToolbarButton}" ToolTip="下一首" Click="NextButton_Click" />
        <Button Name="LyricsModeButton" Content="原+中" Style="{StaticResource LyricToolbarButton}" MinWidth="48" ToolTip="单击轮换：原文+中文 / 原文+音译 / 音译+中文 / 三语；右键可选择单语" FontFamily="Microsoft YaHei UI" FontSize="12" Click="LyricsModeButton_Click" />
        <Button Content="⚙" Style="{StaticResource LyricToolbarButton}" ToolTip="设置" Click="SettingsButton_Click" />
        <Button Name="LockButton" Content="□" Style="{StaticResource LyricToolbarButton}" ToolTip="锁定位置" Click="LockButton_Click" />
        <Button Content="×" Style="{StaticResource LyricToolbarButton}" ToolTip="关闭桌面歌词" Click="CloseButton_Click" />
        <TextBlock Name="OffsetText" Foreground="#C8FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <local:OutlinedTextBlock x:Name="OriginalText" Grid.Row="1" Text="桌面歌词" FontFamily="Microsoft YaHei UI" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <local:OutlinedTextBlock x:Name="TranslationText" Grid.Row="2" Text="" FontFamily="Microsoft YaHei UI" FontSize="17" TextAlignment="Center" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <local:OutlinedTextBlock x:Name="TertiaryText" Grid.Row="3" Text="" FontFamily="Microsoft YaHei UI" FontSize="15" TextAlignment="Center" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</Window>
