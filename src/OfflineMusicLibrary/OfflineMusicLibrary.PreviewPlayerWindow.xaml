<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="OfflineMusicLibrary.PreviewPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OfflineMusicLibrary Mini"
        Width="420" Height="88"
        MinWidth="420" MaxWidth="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#00FFFFFF"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual">
  <Window.Resources>
    <Style x:Key="MiniControlButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#EAF0F5" />
      <Setter Property="Background" Value="#00FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#353A45" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#464D5A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MiniTitleButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MiniControlButton}">
      <Setter Property="Width" Value="25" />
      <Setter Property="Height" Value="23" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#AEB6C2" />
    </Style>
  </Window.Resources>

  <Border x:Name="WindowFrame"
          Background="#F51F2229"
          BorderBrush="#49505C"
          BorderThickness="1"
          CornerRadius="7"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="26" />
        <RowDefinition Height="61" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar" Background="#272B33" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="31" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Width="20" Height="20" Margin="6,3,5,3"
               Source="Assets/OfflineMusicLibrary-logo.png"
               Stretch="Uniform" />
        <TextBlock Grid.Column="1"
                   Text="OfflineMusicLibrary · MINI"
                   Foreground="#DDE3EA"
                   FontFamily="Segoe UI"
                   FontSize="10.5"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,1,2,1">
          <Button Content="↗" Style="{StaticResource MiniTitleButton}" ToolTip="返回主界面" Click="RestoreButton_Click" />
          <Button Content="×" Style="{StaticResource MiniTitleButton}" ToolTip="关闭迷你模式" Click="CloseButton_Click" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="5,3,5,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="52" Height="52"
                Background="#343944"
                BorderBrush="#535B68"
                BorderThickness="1"
                CornerRadius="4"
                ClipToBounds="True"
                MouseLeftButtonDown="Cover_MouseLeftButtonDown">
          <Grid>
            <Image x:Name="FallbackLogo"
                   Width="35" Height="35"
                   Opacity="0.7"
                   Source="Assets/OfflineMusicLibrary-logo.png"
                   Stretch="Uniform" />
            <Image x:Name="PreviewCoverImage" Stretch="UniformToFill" />
          </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="7,1,6,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="21" />
            <RowDefinition Height="19" />
            <RowDefinition Height="8" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="PreviewTitleText"
                     Text="尚未播放"
                     Foreground="#F4F6F8"
                     FontFamily="Microsoft YaHei UI"
                     FontSize="12"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PreviewArtistText"
                       Text="本地音乐库"
                       Foreground="#AAB2BE"
                       FontSize="10.5"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="MiniTimeText"
                       Grid.Column="1"
                       Text="0:00"
                       Foreground="#747E8D"
                       FontSize="9.5"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
          <ProgressBar x:Name="MiniProgress"
                       Grid.Row="2"
                       Height="2"
                       Minimum="0"
                       Maximum="1"
                       Value="0"
                       Background="#363B46"
                       Foreground="#FF4F5E"
                       BorderThickness="0"
                       VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="|◀" Style="{StaticResource MiniControlButton}" ToolTip="上一首" Click="PreviousButton_Click" />
          <Button x:Name="PlayPauseButton"
                  Content="▶"
                  Style="{StaticResource MiniControlButton}"
                  FontSize="16"
                  ToolTip="播放 / 暂停"
                  Click="PlayPauseButton_Click" />
          <Button Content="▶|" Style="{StaticResource MiniControlButton}" ToolTip="下一首" Click="NextButton_Click" />
          <Button x:Name="FavoriteButton"
                  Content="♡"
                  Style="{StaticResource MiniControlButton}"
                  Foreground="#FF5264"
                  FontSize="17"
                  ToolTip="收藏当前歌曲"
                  Click="FavoriteButton_Click" />
          <Button x:Name="VolumeButton"
                  Content="◖"
                  Style="{StaticResource MiniControlButton}"
                  ToolTip="单击静音；滚轮调节音量"
                  Click="VolumeButton_Click"
                  PreviewMouseWheel="VolumeButton_PreviewMouseWheel" />
          <Button x:Name="QueueToggleButton"
                  Content="☷"
                  Style="{StaticResource MiniControlButton}"
                  ToolTip="展开播放队列"
                  Click="QueueToggleButton_Click" />
        </StackPanel>
      </Grid>

      <Border x:Name="QueuePanel"
              Grid.Row="2"
              Visibility="Collapsed"
              Background="#F7252931"
              BorderBrush="#424853"
              BorderThickness="0,1,0,0">
        <Grid Margin="7,5,7,7">
          <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="当前播放队列"
                       Foreground="#E6EAF0"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="QueueCountText"
                       Text="0 首"
                       Foreground="#7F8997"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>
          <ListBox x:Name="MiniQueueList"
                   Grid.Row="1"
                   Background="#00FFFFFF"
                   BorderThickness="0"
                   Foreground="#DCE2E9"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   MouseDoubleClick="MiniQueueList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
              <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                      <Border x:Name="QueueItemBorder"
                              Background="{TemplateBinding Background}"
                              CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="QueueItemBorder" Property="Background" Value="#343944" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="QueueItemBorder" Property="Background" Value="#4A3038" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}"
                             Foreground="#EEF2F6"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Artist}"
                             Foreground="#929CAA"
                             FontSize="10"
                             TextAlignment="Right"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
